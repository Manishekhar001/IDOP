# Copy to .env and replace placeholders before running the app or seed script.
# Use a dedicated, empty Supabase/PostgreSQL demo database and demo Qdrant project.
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
JWT_SECRET_KEY=replace-with-a-random-secret

# Required by the application's SQL generation/judging paths.
OPENAI_API_KEY=replace-with-openai-key
LLM_PROVIDER=litellm
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=replace-with-groq-key

# Embeddings for the demo policy documents.
EMBEDDING_PROVIDER=nomic
NOMIC_API_KEY=replace-with-nomic-key

# Dedicated Qdrant endpoint; the seed writes only to idop_demo_documents.
QDRANT_URL=https://your-demo-cluster.cloud.qdrant.io
QDRANT_API_KEY=replace-with-demo-qdrant-key
COLLECTION_NAME=idop_demo_documents

# Point all three database settings to the same dedicated demo database.
# For the local Compose Postgres service, use:
# postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5432/postgres
IDOP_DEMO_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
IDOP_DEMO_SEED_CONFIRM=I_AM_USING_A_DEDICATED_DEMO_DATABASE

STORAGE_BACKEND=local
CACHE_DIR=data/cached_chunks
